{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "e-commerce-back-office": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/e-commerce-back-office",
      "sourceRoot": "projects/e-commerce-back-office/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/e-commerce-back-office",
            "index": "projects/e-commerce-back-office/src/index.html",
            "browser": "projects/e-commerce-back-office/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/e-commerce-back-office/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/e-commerce-back-office/public"
              }
            ],
            "styles": [
              "projects/e-commerce-back-office/src/styles.scss",
               "./node_modules/bootstrap/dist/css/bootstrap.min.css",
               "./node_modules/bootstrap-icons/font/bootstrap-icons.css",
               "./node_modules/ngx-toastr/toastr.css"
            ],
            "scripts": [
              "./node_modules/bootstrap/dist/js/bootstrap.bundle.js",
              "./node_modules/@popperjs/core/dist/umd/popper.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "e-commerce-back-office:build:production"
            },
            "development": {
              "buildTarget": "e-commerce-back-office:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/e-commerce-back-office/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/e-commerce-back-office/public"
              }
            ],
            "styles": [
              "projects/e-commerce-back-office/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "e-commerce-front-office": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/e-commerce-front-office",
      "sourceRoot": "projects/e-commerce-front-office/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/e-commerce-front-office",
            "index": "projects/e-commerce-front-office/src/index.html",
            "browser": "projects/e-commerce-front-office/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/e-commerce-front-office/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/e-commerce-front-office/public"
              }
            ],
            "styles": [
              "projects/e-commerce-front-office/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "e-commerce-front-office:build:production"
            },
            "development": {
              "buildTarget": "e-commerce-front-office:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/e-commerce-front-office/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/e-commerce-front-office/public"
              }
            ],
            "styles": [
              "projects/e-commerce-front-office/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    },
    "e-commerce-library": {
      "projectType": "library",
      "root": "projects/e-commerce-library",
      "sourceRoot": "projects/e-commerce-library/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/e-commerce-library/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/e-commerce-library/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/e-commerce-library/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/e-commerce-library/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
